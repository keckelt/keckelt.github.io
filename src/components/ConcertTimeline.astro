---
// Every act is one dot at its real date; dots that land on the same spot stack up.
// A festival day becomes a tall column, busy years a dense pile. Built at build time.
import concerts from '../data/concerts.json';

const W = 1040;
const PITCH = 6.5; // Distance between dot centres, both across and up
const R = 2.4;
const first = new Date(concerts[0].date).getUTCFullYear();
const last = new Date(concerts[concerts.length - 1].date).getUTCFullYear() + 1;
const t0 = Date.UTC(first, 0, 1), t1 = Date.UTC(last, 0, 1);
const toX = (t: number) => ((t - t0) / (t1 - t0)) * W;

// Snap each night to a column of dot width, then stack its acts on what is already there
const height = new Map<number, number>();
const nights = concerts.map((n) => {
  const col = Math.round(toX(Date.parse(n.date)) / PITCH);
  const base = height.get(col) ?? 0;
  height.set(col, base + n.acts.length);
  const [y, m, d] = n.date.split('-');
  return {
    x: col * PITCH,
    acts: n.acts.map((a, i) => ({ level: base + i, headliner: a.headliner })),
    label: `${d}.${m}.${y}, ${n.venue} — ${n.acts.map((a) => a.band).join(', ')}`,
  };
});
const H = Math.max(...height.values()) * PITCH + 4;
const BASE = H;
const step = last - first > 12 ? 4 : 2;
const ticks: number[] = [];
for (let y = Math.ceil(first / step) * step; y <= last; y += step) ticks.push(y);
---
<div class="timeline">
  <svg viewBox={`-8 0 ${W + 16} ${H + 24}`} role="img" aria-label={`Timeline of ${concerts.length} concert nights, ${first} to ${last - 1}`}>
    {nights.map((n) => (
      <g>
        <title>{n.label}</title>
        {n.acts.map((a) => (
          <circle cx={n.x.toFixed(1)} cy={(BASE - R - 1 - a.level * PITCH).toFixed(1)} r={R} class={a.headliner ? 'head' : 'support'} />
        ))}
      </g>
    ))}
    <line x1="0" y1={BASE} x2={W} y2={BASE} />
    {ticks.map((y) => <text x={toX(Date.UTC(y, 0, 1))} y={H + 18}>{y}</text>)}
  </svg>
</div>

<style>
  .timeline { overflow-x: auto; }
  svg { display: block; width: 100%; min-width: 720px; height: auto; }
  .head { fill: var(--accent); }
  .support { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  g:hover circle { fill: var(--ink); stroke: var(--ink); }
  line { stroke: var(--ink); stroke-width: 1; }
  text { font-family: var(--font-pixel); font-size: 10px; letter-spacing: 0.08em; fill: var(--muted); text-anchor: middle; }
</style>
