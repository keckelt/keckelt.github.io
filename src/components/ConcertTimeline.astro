---
// One column per night, one dot per act. Built at build time from concerts.json.
import concerts from '../data/concerts.json';

const W = 1040, H = 90, BASE = H - 1;
const first = new Date(concerts[0].date).getUTCFullYear();
const last = new Date(concerts[concerts.length - 1].date).getUTCFullYear() + 1;
const t0 = Date.UTC(first, 0, 1), t1 = Date.UTC(last, 0, 1);
const toX = (t: number) => ((t - t0) / (t1 - t0)) * (W - 10) + 5;

let prev = -100;
const nights = concerts.map((n) => {
  const x = Math.max(toX(Date.parse(n.date)), prev + 10); // nudge nights that would overlap
  prev = x;
  const [y, m, d] = n.date.split('-');
  return { ...n, x, label: `${d}.${m}.${y}, ${n.venue} — ${n.acts.map((a) => a.band).join(', ')}` };
});
const step = last - first > 12 ? 4 : 2;
const ticks: number[] = [];
for (let y = first; y <= last; y += step) ticks.push(y);
---
<div class="timeline">
  <svg viewBox={`-16 0 ${W + 32} ${H + 24}`} role="img" aria-label={`Timeline of ${concerts.length} concert nights, ${first} to ${last - 1}`}>
    {nights.map((n) => (
      <g>
        <title>{n.label}</title>
        {n.acts.map((a, i) => (
          <circle cx={n.x} cy={BASE - 8 - i * 11} r="4" class={a.headliner ? 'head' : 'support'} />
        ))}
      </g>
    ))}
    <line x1="0" y1={BASE} x2={W} y2={BASE} />
    {ticks.map((y) => <text x={toX(Date.UTC(y, 0, 1))} y={H + 18}>{y}</text>)}
  </svg>
</div>

<style>
  .timeline { overflow-x: auto; }
  svg { display: block; width: 100%; min-width: 720px; height: auto; }
  .head { fill: var(--accent); }
  .support { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  g:hover circle { stroke: var(--ink); stroke-width: 1.5; }
  line { stroke: var(--ink); stroke-width: 1; }
  text { font-family: var(--font-pixel); font-size: 10px; letter-spacing: 0.08em; fill: var(--muted); text-anchor: middle; }
</style>
