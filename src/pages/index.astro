---
import Base from '../layouts/Base.astro';
import EmbeddingFigure from '../components/EmbeddingFigure.astro';
import { links } from '../data/site';
---
<Base title="Klaus Eckelt" fit>
  <div class="card wrap">
    <h1 class="pixel">Klaus<br /><span class="surname">Eckelt</span></h1>
    <div class="grid">
      <div class="text">
        <p class="intro">I build visual analytics for pharma R&amp;D, down to single cells in tissue. My research is about defining, understanding and comparing groups, and whether their differences are real.</p>
        <p class="mono">Engineering manager at datavisyn<br />PhD, JKU Linz, 2026</p>
      </div>
      <div class="fig">
        <EmbeddingFigure />
      </div>
    </div>
    <nav aria-label="Main">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  </div>
</Base>

<style>
  /* Everything fits one screen: the name, text and links take what they need,
     the figure gets the rest and scales to it (see the .fig container). */
  .card { flex: 1; min-height: 0; display: flex; flex-direction: column; padding-top: clamp(40px, 11svh, 150px); }
  h1 { margin: 0; font-size: clamp(44px, min(9vw, 10svh), 104px); line-height: 0.95; text-transform: uppercase; }
  .grid {
    flex: 1; min-height: 0;
    display: grid; grid-template-columns: 5fr 1fr 6fr; grid-template-rows: minmax(0, 1fr); align-items: end;
    padding-block: clamp(24px, 6svh, 80px) clamp(24px, 6svh, 90px);
  }
  .text { grid-column: 1; display: flex; flex-direction: column; gap: 26px; padding-bottom: 36px; }
  .intro { margin: 0; font-size: clamp(19px, 2.2vw, 24px); font-weight: 300; line-height: 1.45; max-width: 34ch; }
  .surname { color: var(--accent); }
  .mono { margin: 0; }

  /* The figure box is a size container: the figure takes the largest size that
     fits its width and height (caption included) and keeps its 560:480 shape. */
  .fig { grid-column: 3; height: 100%; min-height: 0; container-type: size; display: flex; align-items: flex-end; }
  .fig :global(figure) { width: min(100cqw, calc((100cqh - 24px) * 560 / 480), 560px); }

  nav { display: flex; flex-wrap: wrap; gap: 12px 40px; border-top: 1px solid var(--rule); padding-top: clamp(16px, 3svh, 28px); font-size: 18px; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); gap: clamp(16px, 3svh, 32px); }
    .text, .fig { grid-column: 1; }
    .text { padding-bottom: 0; gap: clamp(12px, 2svh, 26px); }
    .fig { min-height: 120px; }
    nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
    nav a { padding-block: 12px; }
  }

  /* Phones: one row of links and tighter spacing, so the figure keeps a useful size */
  @media (max-width: 600px) {
    .card { padding-top: clamp(24px, 7svh, 72px); }
    .grid { padding-block: clamp(16px, 3svh, 32px) clamp(12px, 2svh, 24px); }
    nav { display: flex; justify-content: space-between; gap: 8px; padding-top: 4px; font-size: 17px; }
    nav a { min-height: 44px; display: inline-flex; align-items: center; padding-block: 0; }
  }

  /* Short phones: smaller text, so the figure keeps a readable size */
  @media (max-width: 600px) and (max-height: 760px) {
    h1 { font-size: 40px; }
    .intro { font-size: 17px; line-height: 1.4; }
    .mono { font-size: 12px; }
  }

  /* Short screens scroll as usual, so the figure needs its own height again */
  @media (max-height: 520px) {
    .fig { height: auto; container-type: normal; }
    .fig :global(figure) { width: min(100%, 560px); }
  }
</style>
