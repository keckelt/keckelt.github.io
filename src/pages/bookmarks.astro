  .bookmarks :global(ul) { padding-left: 1.2em; }
  .bookmarks :global(h2) { font-family: var(--font-pixel); font-weight: 400; font-size: 16px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); margin: 48px 0 8px; }
</style>
