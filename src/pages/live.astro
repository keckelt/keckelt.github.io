---
import Base from '../layouts/Base.astro';
import SubHeader from '../components/SubHeader.astro';
import ConcertTimeline from '../components/ConcertTimeline.astro';
import concerts from '../data/concerts.json';

const acts = concerts.reduce((s, n) => s + n.acts.length, 0);
const venues = new Set(concerts.map((n) => n.venue)).size;
const since = concerts[0].date.slice(0, 4);

---
<Base title="Live — Klaus Eckelt" description="Every concert Klaus Eckelt has been to since 2004, one dot per act.">
  <SubHeader title="Live" intro="Every concert I have been to since 2004: one column per night, one dot per act on the bill." />

  <section class="band wrap live">
    <div class="head">
      <h2 class="label">One dot per act, since {since}</h2>
      <span class="mono">{concerts.length} nights, {acts} acts, {venues} venues</span>
    </div>
    <ConcertTimeline />
    <div class="legend mono">
      <span><i class="dot"></i>headliner</span>
      <span><i class="ring"></i>support</span>
      <span>Hover a column for the night</span>
    </div>
  </section>

</Base>

<style>
  .label { margin: 0; text-transform: uppercase; font-weight: 400; }
  .live { margin-top: clamp(72px, 10vw, 120px); display: flex; flex-direction: column; gap: 16px; }
  .head { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; align-items: baseline; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 12px; margin-top: 8px; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .dot, .ring { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .dot { background: var(--accent); }
  .ring { border: 1.5px solid var(--accent); }
</style>
